# Base de datos PostgreSQL existente. La migración social debe aplicarse manualmente antes de habilitar auth.
DATABASE_URL=

# Administración existente (independiente de Better Auth).
ADMIN_ACCESS_KEY=
AUTH_SECRET=

# Better Auth para usuarios públicos. BETTER_AUTH_SECRET debe tener al menos 32 caracteres aleatorios.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Lista separada por comas. Incluye producción y los previews explícitamente autorizados.
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000

# OAuth Google (configura ambos o Google no se mostrará).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OAuth Discord (configura ambos o Discord no se mostrará).
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Cloudflare R2. Usa un token limitado a estos dos buckets: uno privado temporal y otro público validado.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_UPLOAD_BUCKET=
R2_PUBLIC_BUCKET=
# URL pública sin slash final del bucket público, preferiblemente un dominio personalizado.
R2_PUBLIC_URL=

# Vercel Blob y configuración existente del sitio.
BLOB_READ_WRITE_TOKEN=
SETUP_ENABLED=false
